# ---------------------------------------------------------------------------
#  Supabase 接続情報
#  Supabase ダッシュボード → Project Settings → API からコピーしてください。
#  このファイルを .env.local としてコピーして値を埋めます。
#  anon key は「公開しても安全な鍵」です（RLS でログイン必須にしているため、
#  この鍵だけではデータは読めません）。service_role key は絶対に置かないこと。
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# チーム共有アカウントのメールアドレス。
# Supabase Authentication → Users で1つだけ作成したユーザーのメールを入れます。
# 画面ではこのメールが自動で使われるため、5人はパスワードだけを入力します。
VITE_TEAM_EMAIL=team@example.com

# 表示用のチーム名（任意）
VITE_TEAM_NAME=耐久レースチーム
